---
import PageHeader from "../components/PageHeader.astro"
import Base from "../layouts/Base.astro"
import { loadSite } from "../lib/content"
import { telHref } from "../lib/format"

const { settings: s } = await loadSite()
const phones = [s.phone, s.phone2].filter(Boolean)
---
<Base title="İletişim" path="/iletisim/" description={`${s.companyName}: ${s.address} · Telefon ${s.phone} · ${s.email}`}>
  <PageHeader label="İletişim" title="Bize ulaşın" intro="Projeniz için teklif, bilgi ya da görüşme talepleriniz için arayın, yazın ya da ofisimize uğrayın." />
  <section class="wrap grid gap-12 py-16 md:py-20 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
    <dl class="facts content-start">
      <div><dt>Adres</dt><dd><address class="not-italic">{s.address}</address></dd></div>
      {phones.map((p, i) => <div><dt>Telefon{phones.length > 1 ? ` ${i + 1}` : ""}</dt><dd><a href={telHref(p)} class="mono text-ink no-underline hover:text-brand">{p}</a></dd></div>)}
      {s.fax && <div><dt>Faks</dt><dd class="mono">{s.fax}</dd></div>}
      <div><dt>E-posta</dt><dd><a href={`mailto:${s.email}`} class="mono text-ink no-underline hover:text-brand">{s.email}</a></dd></div>
      {s.legalName && <div><dt>Unvan</dt><dd class="text-ink-soft">{s.legalName}</dd></div>}
    </dl>
    {s.mapUrl && (
      <div class="min-h-96 overflow-hidden bg-mist">
        <iframe class="h-full min-h-96 w-full grayscale" src={s.mapUrl} title={`${s.companyName}: harita`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
    )}
  </section>
</Base>
