---
import Icon from "../components/Icon.astro"
import PageHeader from "../components/PageHeader.astro"
import RichText from "../components/RichText.astro"
import Base from "../layouts/Base.astro"
import { loadSite, pageOf } from "../lib/content"

const site = await loadSite()
const page = pageOf(site, "hakkimizda")
const { services } = site
---
<Base title={page.title} path="/hakkimizda/" description={page.seoDescription}>
  <PageHeader label="Kurumsal" title={page.title} intro={site.settings.tagline} />
  <section class="wrap grid gap-14 py-16 md:py-20 lg:grid-cols-[2fr_1fr] lg:gap-20">
    <RichText html={page.body} class="max-w-[68ch]" />
    <aside>
      <div class="lg:sticky lg:top-24">
        <p class="label">Hizmetler</p>
        <ol class="mt-4">
          {services.map((x, i) => (
            <li class="flex gap-4 border-t border-line py-4 last:border-b"><span class="mono text-sm text-brand">{String(i + 1).padStart(2, "0")}</span><span class="font-medium">{x.title}</span></li>
          ))}
        </ol>
        <a href="/projeler/" class="link mt-8">Projelerimiz<Icon name="arrow-right" /></a>
      </div>
    </aside>
  </section>
</Base>
