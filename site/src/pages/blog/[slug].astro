---
import Flow from "../../components/Flow.astro"
import Photo from "../../components/Photo.astro"
import PostCard from "../../components/PostCard.astro"
import RichText from "../../components/RichText.astro"
import Base from "../../layouts/Base.astro"
import { loadSite } from "../../lib/content"
import { formatDate } from "../../lib/format"
import { shareImageUrl } from "../../lib/image"
import type { Post } from "../../lib/types"

export async function getStaticPaths() {
  const { posts } = await loadSite()
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}
interface Props { post: Post }
const { post } = Astro.props
const { posts, settings } = await loadSite()
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 3)
const image = post.cover ? await shareImageUrl(post.cover) : undefined
const path = `/blog/${post.slug}/`
// Arama motorları için yapılandırılmış veri (çalıştırılmayan veri bloğu; CSP script kuralına takılmaz)
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt || undefined,
  datePublished: post.date,
  inLanguage: "tr",
  mainEntityOfPage: new URL(path, Astro.site).href,
  image: image ? new URL(image, Astro.site).href : undefined,
  author: { "@type": "Organization", name: settings.companyName },
  publisher: { "@type": "Organization", name: settings.companyName, logo: { "@type": "ImageObject", url: new URL("/logo.svg", Astro.site).href } },
}).replace(/</g, "\\u003c")
---
<Base title={post.title} path={path} description={post.excerpt || undefined} image={image}>
  <script type="application/ld+json" set:html={ld} />
  <article>
    <header class="night relative isolate overflow-hidden">
      <Flow class="-z-20" />
      <div class="night-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="mx-auto max-w-3xl px-5 py-14 md:py-20">
        <nav aria-label="Sayfa yolu" class="text-sm"><a href="/blog/" class="font-semibold text-white/65 no-underline hover:text-white">Blog</a></nav>
        <h1 class="rise mt-5 text-[clamp(1.9rem,4.2vw,3rem)]">{post.title}</h1>
        <p class="rise d1 mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-white/70">
          {post.category && <span class="chip">{post.category}</span>}
          <time datetime={post.date}>{formatDate(post.date)}</time>
        </p>
      </div>
    </header>
    <div class="mx-auto max-w-3xl px-5 py-12 md:py-16">
      {post.cover && <Photo img={post.cover} alt="" width={1200} sizes="(min-width: 768px) 720px, 100vw" class="mb-10 aspect-[16/9] w-full rounded-lg object-cover" loading="eager" />}
      {post.excerpt && <p class="mb-8 text-xl leading-relaxed text-ink-soft">{post.excerpt}</p>}
      <RichText html={post.body} />
    </div>
  </article>
  {more.length > 0 && (
    <section class="border-t border-line bg-mist">
      <div class="wrap py-16">
        <h2 class="text-2xl">Diğer yazılar</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">{more.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>
