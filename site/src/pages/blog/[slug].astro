---
import Photo from "../../components/Photo.astro"
import PostCard from "../../components/PostCard.astro"
import RichText from "../../components/RichText.astro"
import Base from "../../layouts/Base.astro"
import { loadSite } from "../../lib/content"
import { formatDate } from "../../lib/format"
import { shareImageUrl } from "../../lib/image"
import type { Post } from "../../lib/types"

export async function getStaticPaths() {
  const { posts } = await loadSite()
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}
interface Props { post: Post }
const { post } = Astro.props
const { posts, settings } = await loadSite()
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 3)
const image = post.cover ? await shareImageUrl(post.cover) : undefined
const path = `/blog/${post.slug}/`
// Arama motorları için yapılandırılmış veri (çalıştırılmayan veri bloğu; CSP script kuralına takılmaz)
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt || undefined,
  datePublished: post.date,
  inLanguage: "tr",
  mainEntityOfPage: new URL(path, Astro.site).href,
  image: image ? new URL(image, Astro.site).href : undefined,
  author: { "@type": "Organization", name: settings.companyName },
  publisher: { "@type": "Organization", name: settings.companyName, logo: { "@type": "ImageObject", url: new URL("/logo.svg", Astro.site).href } },
}).replace(/</g, "\\u003c")
---
<Base title={post.title} path={path} description={post.excerpt || undefined} image={image}>
  <script type="application/ld+json" set:html={ld} />
  <article>
    <header class="wrap pb-10 pt-12 md:pt-16">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Sayfa yolu" class="label"><a href="/blog/" class="text-ink-soft no-underline hover:text-ink">Blog</a>{post.category && <> / {post.category}</>}</nav>
        <h1 class="fade mt-5 text-[clamp(2rem,4.4vw,3.25rem)]">{post.title}</h1>
        <p class="mono mt-5 text-sm text-ink-soft"><time datetime={post.date}>{formatDate(post.date)}</time> · {settings.companyName}</p>
      </div>
    </header>
    {post.cover && (
      <div class="wrap">
        <Photo img={post.cover} alt="" width={1600} sizes="(min-width: 1312px) 1248px, 100vw" class="aspect-[21/9] w-full bg-mist object-cover" loading="eager" />
      </div>
    )}
    <div class="wrap py-12 md:py-16">
      <div class="mx-auto max-w-3xl">
        {post.excerpt && <p class="mb-8 text-xl leading-relaxed text-ink-soft">{post.excerpt}</p>}
        <RichText html={post.body} />
      </div>
    </div>
  </article>
  {more.length > 0 && (
    <section class="border-t border-line bg-canvas">
      <div class="wrap py-16 md:py-20">
        <p class="label">Diğer yazılar</p>
        <div class="mt-6 border-b border-line">{more.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>
