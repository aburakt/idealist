---
import Icon from "../components/Icon.astro"
import Photo from "../components/Photo.astro"
import PostCard from "../components/PostCard.astro"
import ProjectCard from "../components/ProjectCard.astro"
import Base from "../layouts/Base.astro"
import { loadSite, projectsIn } from "../lib/content"
import { formatNumber } from "../lib/format"

const site = await loadSite()
const { settings: s, services, areas, projects, posts } = site
const featured = projects.filter((p) => p.featured).slice(0, 6)
const totalM2 = projects.reduce((sum, p) => sum + (p.areaM2 ?? 0), 0)
const millions = Math.floor(totalM2 / 100_000) / 10
const countries = new Set(projects.map((p) => (p.areas.includes("yurt-disi") ? p.location.split(",").pop()?.trim() : "Türkiye")).filter(Boolean)).size
const stats: [string, string][] = [
  ...(s.foundedYear ? [[String(s.foundedYear), "Kuruluş"] as [string, string]] : []),
  [String(projects.length), "Proje"],
  ...(millions >= 1 ? [[`${formatNumber(millions)} milyon\u00a0m²`, "Toplam proje alanı"] as [string, string]] : []),
  ...(countries > 1 ? [[String(countries), "Ülke"] as [string, string]] : [[String(areas.length), "Faaliyet alanı"] as [string, string]]),
]
// seçili projeler: geniş ve dar kartlar sırayla (7/5, 5/7) yan yana; lg'de görsel yüksekliği sabit, başlıklar aynı hizada
// (oranla eşitleme sütun boşlukları yüzünden ~13px kayıyordu)
const wide = (i: number) => i % 4 === 0 || i % 4 === 3
---
<Base title="Ana sayfa" path="/">
  <section class="wrap pb-10 pt-14 md:pt-20">
    {s.tagline && <p class="label fade">{s.tagline}</p>}
    <div class="mt-6 grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-end lg:gap-20">
      <h1 class="fade text-[clamp(2.3rem,5.4vw,4.6rem)]">{s.heroTitle}</h1>
      <div class="fade">
        {s.heroText && <p class="max-w-[46ch] text-lg text-ink-soft">{s.heroText}</p>}
        <p class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          <a href="/projeler/" class="link">Projelerimiz<Icon name="arrow-right" /></a>
          <a href="/iletisim/" class="link">İletişim<Icon name="arrow-right" /></a>
        </p>
      </div>
    </div>
  </section>

  {s.heroImage && (
    <div class="wrap fade">
      <div class="aspect-[16/10] overflow-hidden bg-mist md:aspect-[21/9]">
        <Photo img={s.heroImage} alt="" class="size-full object-cover" width={2000} sizes="(min-width: 1312px) 1248px, 100vw" loading="eager" />
      </div>
    </div>
  )}

  <section class="wrap">
    <dl class="grid grid-cols-2 border-b border-line lg:grid-cols-4">
      {stats.map(([value, label], i) => (
        <div class:list={["py-7 md:py-9", i % 2 === 1 && "pl-5 lg:pl-0", i >= 2 && "border-t border-line lg:border-t-0"]}>
          <dt class="label">{label}</dt>
          <dd class="mono mt-2 text-[clamp(1.25rem,2.2vw,1.9rem)] font-medium leading-tight text-ink">{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="label"><span class="label-num">01</span>Seçili projeler</p>
        <h2 class="mt-4 max-w-[22ch] text-[clamp(1.8rem,3.4vw,2.75rem)]">Yurt içinde ve yurt dışında</h2>
      </div>
      <a href="/projeler/" class="link">Tüm projeler ({projects.length})<Icon name="arrow-right" /></a>
    </div>
    <div class="mt-12 grid gap-x-8 gap-y-14 lg:grid-cols-12">
      {featured.map((p, i) => (
        <div class={wide(i) ? "lg:col-span-7" : "lg:col-span-5"}>
          <ProjectCard project={p} large aspect="aspect-[3/2] lg:aspect-auto lg:h-[clamp(20rem,36vw,29rem)]" sizes={wide(i) ? "(min-width: 1024px) 58vw, 100vw" : "(min-width: 1024px) 42vw, 100vw"} />
        </div>
      ))}
    </div>
  </section>

  <section id="hizmetler" class="scroll-mt-24 bg-canvas">
    <div class="wrap grid gap-12 py-20 md:py-28 lg:grid-cols-[1fr_2fr] lg:gap-20">
      <div>
        <p class="label"><span class="label-num">02</span>Hizmetler</p>
        <h2 class="mt-4 max-w-[16ch] text-[clamp(1.8rem,3.4vw,2.75rem)]">Tasarımdan uygulamaya tek ekip</h2>
        <a href="/hakkimizda/" class="link mt-8">Hakkımızda<Icon name="arrow-right" /></a>
      </div>
      <ol class="grid sm:grid-cols-2 sm:gap-x-10">
        {services.map((x, i) => (
          <li class="border-t border-ink/15 py-7">
            <p class="mono text-sm text-brand">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-3 text-xl font-medium">{x.title}</h3>
            {x.summary && <p class="mt-2 text-ink-soft">{x.summary}</p>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap py-20 md:py-28">
    <p class="label"><span class="label-num">03</span>Faaliyet alanları</p>
    <h2 class="mt-4 max-w-[24ch] text-[clamp(1.8rem,3.4vw,2.75rem)]">Hastaneden konuta, ofisten sanayiye</h2>
    <ul class="mt-12 grid sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-3">
      {areas.map((a) => {
        const count = projectsIn(site, a.slug).length
        return (
          <li class="border-t border-line">
            <a href={`/faaliyet-alanlari/${a.slug}/`} class="group flex items-baseline justify-between gap-4 py-4 text-ink no-underline">
              <span class="decoration-brand underline-offset-4 group-hover:underline">{a.title}</span>
              <span class="mono text-sm text-ink-soft">{String(count).padStart(2, "0")}</span>
            </a>
          </li>
        )
      })}
    </ul>
  </section>

  {posts.length > 0 && (
    <section class="border-t border-line">
      <div class="wrap py-20 md:py-28">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="label"><span class="label-num">04</span>Yazılar</p>
            <h2 class="mt-4 text-[clamp(1.8rem,3.4vw,2.75rem)]">Mekanik tesisat üzerine notlar</h2>
          </div>
          <a href="/blog/" class="link">Tüm yazılar<Icon name="arrow-right" /></a>
        </div>
        <div class="mt-10 border-b border-line">
          {posts.slice(0, 3).map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>
