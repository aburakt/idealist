---
import { getImage } from "astro:assets"
import Icon from "../../components/Icon.astro"
import Photo from "../../components/Photo.astro"
import ProjectCard from "../../components/ProjectCard.astro"
import Base from "../../layouts/Base.astro"
import { loadSite } from "../../lib/content"
import { formatM2, paragraphs } from "../../lib/format"
import { isRemoteRaster, remoteDims, shareImageUrl } from "../../lib/image"
import type { Img, Project } from "../../lib/types"

export async function getStaticPaths() {
  const { projects } = await loadSite()
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}
interface Props { project: Project }
const { project: p } = Astro.props
const site = await loadSite()
const areas = site.areas.filter((a) => p.areas.includes(a.slug))
const facts: [string, string][] = [
  ["Kullanım", p.usage],
  ["İşveren", p.client],
  ["Mimari", p.architect],
  ["Yıl", p.year ? String(p.year) : ""],
  ["Konum", p.location],
  ["Alan", p.areaM2 ? formatM2(p.areaM2) : ""],
].filter((f): f is [string, string] => !!f[1])
// galeri: büyük görüntü için en fazla 2000 px WebP (görüntüleyici açar), küçük resim sayfada
const large = async (img: Img) => {
  if (isRemoteRaster(img.src)) {
    const d = await remoteDims(img.src, 2000)
    return (await getImage({ src: img.src, width: d.width, height: d.height, format: "webp", quality: 82 })).src
  }
  if (typeof img.src === "string") return img.src
  const w = Math.min(2000, img.src.width)
  return (await getImage({ src: img.src, width: w, format: "webp", quality: 82 })).src
}
const full = await Promise.all(p.images.map(large))
const [cover, ...rest] = p.images
const related = site.projects.filter((x) => x.slug !== p.slug && x.areas.some((a) => p.areas.includes(a))).slice(0, 3)
const share = cover ? await shareImageUrl(cover) : undefined
const desc = [p.name, p.usage, p.location, p.areaM2 ? formatM2(p.areaM2) : ""].filter(Boolean).join(" · ") + `. ${site.settings.companyName} mekanik tesisat projesi.`
---
<Base title={p.name} path={`/projeler/${p.slug}/`} description={desc} image={share}>
  <section class="wrap pb-10 pt-12 md:pt-16">
    <nav aria-label="Sayfa yolu" class="label">
      <a href="/projeler/" class="text-ink-soft no-underline hover:text-ink">Projeler</a>
      {areas.map((a) => <> / <a href={`/faaliyet-alanlari/${a.slug}/`} class="text-ink-soft no-underline hover:text-ink">{a.title}</a></>)}
    </nav>
    <h1 class="fade mt-5 max-w-[24ch] text-[clamp(2.1rem,4.8vw,3.75rem)]">{p.name}</h1>
  </section>

  <section class="wrap grid gap-10 pb-20 lg:grid-cols-[2fr_1fr] lg:gap-14">
    <div data-gallery class="lg:order-1">
      {cover && (
        <a href={full[0]} data-gallery-item class="photo group relative block overflow-hidden bg-mist">
          <Photo img={cover} alt={p.name} class="w-full" width={1600} sizes="(min-width: 1024px) 66vw, 100vw" loading="eager" />
          <span class="absolute bottom-3 right-3 grid size-10 place-items-center bg-paper text-ink opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"><Icon name="expand" class="size-5" /></span>
        </a>
      )}
      {rest.length > 0 && (
        <ul class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4">
          {rest.map((img, i) => (
            <li>
              <a href={full[i + 1]} data-gallery-item class="photo block aspect-[4/3] overflow-hidden bg-mist">
                <Photo img={img} alt={`${p.name}, görsel ${i + 2}`} class="size-full object-cover" width={480} sizes="(min-width: 1024px) 15vw, 30vw" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    <aside class="lg:order-2">
      <div class="lg:sticky lg:top-24">
        {facts.length > 0 && (
          <dl class="facts">
            {facts.map(([k, v]) => (
              <div><dt>{k}</dt><dd class:list={[(k === "Alan" || k === "Yıl") && "mono"]}>{v}</dd></div>
            ))}
          </dl>
        )}
        {paragraphs(p.summary).map((t) => <p class="mt-5 text-ink-soft">{t}</p>)}
        <a href="/iletisim/" class="link mt-8">Benzer bir proje için iletişime geçin<Icon name="arrow-right" /></a>
      </div>
    </aside>
  </section>

  {related.length > 0 && (
    <section class="border-t border-line bg-canvas">
      <div class="wrap py-16 md:py-20">
        <p class="label">Aynı alandaki diğer projeler</p>
        <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">{related.map((x) => <ProjectCard project={x} />)}</div>
      </div>
    </section>
  )}

  <dialog class="viewer" data-viewer aria-label="Proje görselleri">
    <div class="grid size-full grid-rows-[auto_1fr_auto]">
      <div class="flex items-center justify-between p-4 text-sm text-white/80">
        <span data-viewer-count></span>
        <button type="button" data-viewer-close class="grid size-11 cursor-pointer place-items-center text-white hover:bg-white/10" aria-label="Kapat"><Icon name="close" class="size-6" /></button>
      </div>
      <div class="flex min-h-0 items-center justify-center px-4"><img data-viewer-img alt="" /></div>
      <div class="flex justify-center gap-3 p-4">
        <button type="button" data-viewer-prev class="grid size-12 cursor-pointer place-items-center border border-white/25 text-white hover:bg-white/10" aria-label="Önceki görsel"><Icon name="arrow-left" class="size-6" /></button>
        <button type="button" data-viewer-next class="grid size-12 cursor-pointer place-items-center border border-white/25 text-white hover:bg-white/10" aria-label="Sonraki görsel"><Icon name="arrow-right" class="size-6" /></button>
      </div>
    </div>
  </dialog>
</Base>
<script>import "../../scripts/gallery"</script>
