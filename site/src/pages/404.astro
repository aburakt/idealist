---
import Icon from "../components/Icon.astro"
import Base from "../layouts/Base.astro"
---
<Base title="404" path="/404/">
  <section class="wrap pb-20 pt-20 md:pt-28">
    <p class="text-[clamp(5rem,20vw,12rem)] font-bold leading-[0.85] text-brand" aria-hidden="true">404</p>
    <h1 class="mt-6 text-[clamp(1.8rem,4vw,3rem)]">Sayfa bulunamadı</h1>
    <p class="mt-3 max-w-[48ch] text-lg text-ink-soft">Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-brand">Ana sayfa<Icon name="arrow-right" /></a>
      <a href="/projeler/" class="btn btn-outline">Projeler</a>
    </div>
  </section>
</Base>
