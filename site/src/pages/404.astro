---
import Icon from "../components/Icon.astro"
import Base from "../layouts/Base.astro"
---
<Base title="404" path="/404/">
  <section class="wrap pb-24 pt-20 md:pt-28">
    <p class="label"><span class="label-num">404</span>Hata</p>
    <h1 class="mt-6 text-[clamp(2.2rem,5vw,4rem)]">Sayfa bulunamadı</h1>
    <p class="mt-4 max-w-[48ch] text-lg text-ink-soft">Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir.</p>
    <p class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
      <a href="/" class="link">Ana sayfa<Icon name="arrow-right" /></a>
      <a href="/projeler/" class="link">Projeler<Icon name="arrow-right" /></a>
    </p>
  </section>
</Base>
