---
import Icon from "../../components/Icon.astro"
import Photo from "../../components/Photo.astro"
import RichText from "../../components/RichText.astro"
import Base from "../../layouts/Base.astro"
import { loadSite, pageOf, projectsIn } from "../../lib/content"
import { telHref } from "../../lib/format"

// Eski sitenin en.html sayfası: tek sayfalık İngilizce özet. Metin Sayfalar > "en" kaydından, adlar *_en alanlarından gelir.
const site = await loadSite()
const page = pageOf(site, "en")
const { settings: s, services, areas } = site
const phones = [s.phone, s.phone2].filter(Boolean)
---
<Base title={page.title} path="/en/" lang="en" description={page.seoDescription ?? "Idealist Engineering: mechanical installation design and consultancy since 2004. Hospitals, residential, office, retail, hotel and international projects. Ankara, Türkiye."}>
  <section class="wrap pb-10 pt-14 md:pt-20">
    <p class="label fade">Quality, modern and reliable projects</p>
    <div class="mt-6 grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-end lg:gap-20">
      <h1 class="fade text-[clamp(2.3rem,5.4vw,4.6rem)]">{page.title}</h1>
      <div class="fade">
        <p class="max-w-[46ch] text-lg text-ink-soft">Mechanical installation design and consultancy since {s.foundedYear ?? 2004}, for domestic and international projects.</p>
        <p class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          <a href="/projeler/" class="link">Our projects<Icon name="arrow-right" /></a>
          <a href="#contact" class="link">Contact<Icon name="arrow-right" /></a>
        </p>
      </div>
    </div>
  </section>
  {s.heroImage && (
    <div class="wrap fade">
      <div class="aspect-[16/10] overflow-hidden bg-mist md:aspect-[21/9]"><Photo img={s.heroImage} alt="" class="size-full object-cover" width={2000} sizes="(min-width: 1312px) 1248px, 100vw" loading="eager" /></div>
    </div>
  )}

  <section id="about" class="wrap scroll-mt-24 py-20 md:py-28">
    <p class="label"><span class="label-num">01</span>About us</p>
    <RichText html={page.body} class="mt-6 max-w-[70ch]" />
  </section>

  <section id="services" class="scroll-mt-24 bg-canvas">
    <div class="wrap py-20 md:py-28">
      <p class="label"><span class="label-num">02</span>Services</p>
      <ol class="mt-10 grid sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-4">
        {services.map((x, i) => (
          <li class="border-t border-ink/15 py-6"><p class="mono text-sm text-brand">{String(i + 1).padStart(2, "0")}</p><p class="mt-3 text-lg font-medium">{x.titleEn || x.title}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section id="fields" class="wrap scroll-mt-24 py-20 md:py-28">
    <p class="label"><span class="label-num">03</span>Fields of activity</p>
    <ul class="mt-10 grid sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-3">
      {areas.map((a) => (
        <li class="border-t border-line">
          <a href={`/faaliyet-alanlari/${a.slug}/`} class="group flex items-baseline justify-between gap-4 py-4 text-ink no-underline">
            <span class="decoration-brand underline-offset-4 group-hover:underline">{a.titleEn || a.title}</span>
            <span class="mono text-sm text-ink-soft">{String(projectsIn(site, a.slug).length).padStart(2, "0")} projects</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" class="scroll-mt-24 border-t border-line bg-canvas">
    <div class="wrap grid gap-10 py-20 md:grid-cols-2">
      <div>
        <p class="label"><span class="label-num">04</span>Contact</p>
        <h2 class="mt-4 text-[clamp(1.8rem,3.4vw,2.75rem)]">Get in touch</h2>
      </div>
      <dl class="facts">
        <div><dt>Address</dt><dd><address class="not-italic">{s.address}</address></dd></div>
        {phones.map((p) => <div><dt>Phone</dt><dd><a href={telHref(p)} class="mono text-ink no-underline hover:text-brand">{p}</a></dd></div>)}
        {s.fax && <div><dt>Fax</dt><dd class="mono">{s.fax}</dd></div>}
        <div><dt>Email</dt><dd><a href={`mailto:${s.email}`} class="mono text-ink no-underline hover:text-brand">{s.email}</a></dd></div>
      </dl>
    </div>
  </section>
</Base>
