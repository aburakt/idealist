---
import Icon from "./Icon.astro"
import Logo from "./Logo.astro"

interface Props { lang?: "tr" | "en" }
const { lang = "tr" } = Astro.props
const en = lang === "en"
const nav: [string, string][] = en
  ? [["About", "/en/#about"], ["Services", "/en/#services"], ["Fields", "/en/#fields"], ["Projects", "/projeler/"], ["Contact", "/en/#contact"]]
  : [["Projeler", "/projeler/"], ["Hizmetler", "/#hizmetler"], ["Hakkımızda", "/hakkimizda/"], ["Blog", "/blog/"], ["İletişim", "/iletisim/"]]
const path = Astro.url.pathname
const current = (href: string) => !href.includes("#") && (path.startsWith(href) || (href === "/projeler/" && path.startsWith("/faaliyet-alanlari/")))
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-white">{en ? "Skip to content" : "İçeriğe geç"}</a>
<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <nav class="wrap flex h-18 items-center justify-between gap-6" aria-label={en ? "Main menu" : "Ana menü"}>
    <a href={en ? "/en/" : "/"} class="block shrink-0" aria-label={en ? "Idealist Engineering home" : "İdealist Mühendislik ana sayfa"}><Logo class="h-8 w-auto md:h-9" /></a>
    <ul class="hidden items-center gap-9 text-[0.95rem] lg:flex">
      {nav.map(([label, href]) => (
        <li><a href={href} aria-current={current(href) ? "page" : undefined} class="text-ink-soft no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-brand aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[1.6rem]">{label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-5">
      <a href={en ? "/" : "/en/"} lang={en ? "tr" : "en"} hreflang={en ? "tr" : "en"} class="mono text-sm text-ink-soft no-underline hover:text-ink" aria-label={en ? "Türkçe" : "English"}>{en ? "TR" : "EN"}</a>
      <details class="group relative lg:hidden">
        <summary class="grid size-11 cursor-pointer list-none place-items-center [&::-webkit-details-marker]:hidden" aria-label={en ? "Menu" : "Menü"}>
          <Icon name="menu" class="size-6 group-open:hidden" /><Icon name="close" class="hidden size-6 group-open:block" />
        </summary>
        <div class="fixed inset-x-0 top-18 border-y border-line bg-paper">
          <ul class="wrap grid py-3 text-lg">
            {nav.map(([label, href]) => <li><a href={href} class="block border-b border-line py-4 text-ink no-underline last:border-0">{label}</a></li>)}
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
