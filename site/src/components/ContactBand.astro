---
import Icon from "./Icon.astro"
import { telHref } from "../lib/format"
import { loadSite } from "../lib/content"

const { settings: s } = await loadSite()
---
<section class="bg-brand text-white">
  <div class="wrap flex flex-col gap-8 py-14 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-[clamp(1.6rem,3vw,2.25rem)]">Projeniz için birlikte çalışalım</h2>
      <p class="mt-2 max-w-[52ch] text-white/85">Mekanik tesisat tasarımı ve müşavirlik ihtiyaçlarınız için bize telefon ya da e-postayla ulaşın.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={telHref(s.phone)} class="btn btn-white"><Icon name="phone" />{s.phone}</a>
      <a href={`mailto:${s.email}`} class="btn border-[1.5px] border-white/50 text-white hover:border-white"><Icon name="mail" />E-posta gönderin</a>
    </div>
  </div>
</section>
