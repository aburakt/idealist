---
import { loadSite, projectsIn } from "../lib/content"

interface Props { current?: string }
const { current } = Astro.props
const site = await loadSite()
const items = [
  { href: "/projeler/", label: "Tüm projeler", count: site.projects.length, active: !current },
  ...site.areas.map((a) => ({ href: `/faaliyet-alanlari/${a.slug}/`, label: a.title, count: projectsIn(site, a.slug).length, active: current === a.slug })),
].filter((x) => x.count > 0)
---
<nav class="mt-8 flex flex-wrap gap-2" aria-label="Faaliyet alanları">
  {items.map((x) => (
    <a href={x.href} aria-current={x.active ? "page" : undefined} class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-4 py-2 text-sm font-semibold text-ink no-underline hover:border-ink aria-[current=page]:border-ink aria-[current=page]:bg-ink aria-[current=page]:text-white">
      {x.label}<span class="tabular-nums opacity-60">{x.count}</span>
    </a>
  ))}
</nav>
