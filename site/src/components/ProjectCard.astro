---
import Photo from "./Photo.astro"
import { formatM2 } from "../lib/format"
import type { Project } from "../lib/types"

// aspect: yan yana farklı genişlikteki kartların görsel yükseklikleri eşit olsun diye dışarıdan verilebilir
// level: kart başlığının seviyesi. Liste doğrudan sayfa h1'inin altındaysa 2, bir h2 bölümünün içindeyse 3 (başlık sırası);
// görünüm iki seviyede de aynı (h3 satır aralığı ve harf aralığı sınıfla sabit)
interface Props { project: Project; large?: boolean; eager?: boolean; sizes?: string; aspect?: string; level?: 2 | 3 }
const { project: p, large = false, eager = false, sizes, aspect, level = 3 } = Astro.props
const Heading = level === 2 ? "h2" : "h3"
const cover = p.images[0]
const meta = [p.location, p.year ? String(p.year) : ""].filter(Boolean).join(" · ")
---
<a href={`/projeler/${p.slug}/`} class="photo group block text-ink no-underline">
  <div class:list={["overflow-hidden bg-mist", aspect ?? (large ? "aspect-[3/2]" : "aspect-[4/3]")]}>
    {cover && <Photo img={cover} alt={p.name} class="size-full object-cover" width={large ? 1400 : 800} sizes={sizes ?? (large ? "(min-width: 1024px) 66vw, 100vw" : "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw")} loading={eager ? "eager" : "lazy"} />}
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-4 border-t border-transparent">
    <Heading class:list={["card-title font-medium decoration-brand underline-offset-4 group-hover:underline", large ? "text-xl" : "text-[1.05rem]"]}>{p.name}</Heading>
    {p.areaM2 && <p class="mono shrink-0 whitespace-nowrap text-xs text-ink-soft">{formatM2(p.areaM2)}</p>}
  </div>
  {(p.usage || meta) && <p class="mt-1 text-sm text-ink-soft">{[p.usage, meta].filter(Boolean).join(" · ")}</p>}
</a>
