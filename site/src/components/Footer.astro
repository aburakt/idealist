---
import Logo from "./Logo.astro"
import { telHref } from "../lib/format"
import { loadSite } from "../lib/content"

interface Props { lang?: "tr" | "en" }
const { lang = "tr" } = Astro.props
const en = lang === "en"
const { settings: s } = await loadSite()
const year = new Date().getFullYear()
const links: [string, string][] = en
  ? [["Projects", "/projeler/"], ["About", "/en/#about"], ["Contact", "/en/#contact"], ["Türkçe", "/"]]
  : [["Projeler", "/projeler/"], ["Hakkımızda", "/hakkimizda/"], ["Blog", "/blog/"], ["İletişim", "/iletisim/"], ["English", "/en/"]]
---
<footer class="bg-night text-white/70">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <Logo tone="light" class="h-9 w-auto" />
      {!en && s.footerText && <p class="mt-6 max-w-[38ch]">{s.footerText}</p>}
    </div>
    <div>
      <p class="label text-white/45">{en ? "Contact" : "İletişim"}</p>
      <address class="mt-4 max-w-[34ch] not-italic">{s.address}</address>
      <ul class="mono mt-4 grid gap-1.5 text-sm">
        {[s.phone, s.phone2].filter(Boolean).map((p) => <li><a href={telHref(p)} class="text-white no-underline hover:underline">{p}</a></li>)}
        {s.fax && <li>{en ? "Fax" : "Faks"} {s.fax}</li>}
        <li><a href={`mailto:${s.email}`} class="text-white no-underline hover:underline">{s.email}</a></li>
      </ul>
    </div>
    <div>
      <p class="label text-white/45">{en ? "Pages" : "Sayfalar"}</p>
      <ul class="mt-4 grid gap-1.5">
        {links.map(([label, href]) => <li><a href={href} class="text-white/80 no-underline hover:text-white">{label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-5 text-sm text-white/45 sm:flex-row sm:justify-between">
      <p>© {year} {s.companyName}</p>
      {s.legalName && <p>{s.legalName}</p>}
    </div>
  </div>
</footer>
