---
import { loadSite } from "../lib/content"

// Sağ altta yalnız simgeden oluşan WhatsApp düğmesi. Site Ayarları > whatsapp_url boşsa hiç çıkmaz.
const { settings } = await loadSite()
const href = settings.whatsappUrl
---
