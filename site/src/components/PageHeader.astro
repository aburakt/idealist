---
// Sayfa başlığı: sade, beyaz zemin. Numaralı etiket + büyük başlık + kısa giriş; altında ince çizgi.
interface Props { label?: string; title: string; intro?: string }
const { label, title, intro } = Astro.props
---
<section class="border-b border-line">
  <div class="wrap pb-12 pt-14 md:pb-16 md:pt-20">
    <slot name="before" />
    {label && <p class="label fade">{label}</p>}
    <div class="mt-5 grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-end lg:gap-16">
      <h1 class="fade text-[clamp(2.2rem,5vw,4rem)]">{title}</h1>
      {intro && <p class="fade max-w-[52ch] text-lg text-ink-soft">{intro}</p>}
    </div>
    <slot />
  </div>
</section>
